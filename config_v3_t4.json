{
  "model": {
    "name": "SVAROG V3 T4",
    "architecture": "llama",
    "vocab_size": 24000,
    "max_position_embeddings": 2048,
    "hidden_size": 768,
    "num_hidden_layers": 12,
    "num_attention_heads": 12,
    "intermediate_size": 3072,
    "hidden_act": "silu",
    "initializer_range": 0.02,
    "rms_norm_eps": 0.000001,
    "tie_word_embeddings": true,
    "pad_token_id": 0,
    "bos_token_id": 2,
    "eos_token_id": 3
  },
  "training": {
    "backend": "native_pytorch",
    "batch_size": 2,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0002,
    "weight_decay": 0.1,
    "max_grad_norm": 1,
    "seed": 42,
    "mixed_precision": "fp16"
  },
  "tokenizer": {
    "type": "sentencepiece",
    "model_type": "bpe",
    "vocab_size": 24000,
    "model_path": "tokenizer/svarog_v3_t4.model",
    "pad_token_id": 0,
    "unk_token_id": 1,
    "bos_token_id": 2,
    "eos_token_id": 3
  }
}
